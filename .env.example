# ─── PostgreSQL ───
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=nuhiris_db
DATABASE_USER=nuhiris_app
DATABASE_PASSWORD=changeme_dev_only

# ─── Redis ───
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── Keycloak ───
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=nuhiris
KEYCLOAK_CLIENT_ID=nuhiris-api
KEYCLOAK_CLIENT_SECRET=changeme_dev_only
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# ─── MinIO (S3-compatible object store) ───
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=nuhiris-documents
MINIO_USE_SSL=false

# ─── JWT ───
JWT_PUBLIC_KEY_URL=http://localhost:8080/realms/nuhiris/protocol/openid-connect/certs
JWT_DEV_SECRET=nuhiris-dev-secret-do-not-use-in-production

# ─── Encryption ───
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
HMAC_KEY=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210

# ─── External APIs (mock in dev) ───
USE_REAL_NIMC=false
NINAUTH_API_URL=http://localhost:3000/api/v1/mock/ninauth
NINAUTH_API_KEY=mock-api-key-dev-only

# ─── App ───
PORT=3000
CORS_ORIGIN=http://localhost:3001
NODE_ENV=development
