{
  "realm": "nuhiris",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 1800,
  "maxDeltaTimeSeconds": 3600,
  "failureFactor": 5,
  "accessTokenLifespan": 900,
  "ssoSessionMaxLifespan": 604800,
  "offlineSessionMaxLifespan": 604800,
  "roles": {
    "realm": [
      { "name": "national_admin", "description": "National system administrator" },
      { "name": "facility_admin", "description": "Facility-level administrator" },
      { "name": "medical_officer", "description": "Doctor / Medical officer" },
      { "name": "nurse", "description": "Nurse / Midwife" },
      { "name": "pharmacist", "description": "Pharmacist" },
      { "name": "lab_scientist", "description": "Laboratory scientist" },
      { "name": "health_records_officer", "description": "Health records officer" },
      { "name": "audit_inspector", "description": "Audit and compliance inspector" },
      { "name": "patient", "description": "Patient self-service" }
    ]
  },
  "clients": [
    {
      "clientId": "nuhiris-api",
      "name": "NUHIRIS API",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "changeme_dev_only",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "defaultClientScopes": ["openid", "profile", "email", "roles"]
    },
    {
      "clientId": "nuhiris-web",
      "name": "NUHIRIS Web Portal",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:3001/*"],
      "webOrigins": ["http://localhost:3001"],
      "protocol": "openid-connect",
      "defaultClientScopes": ["openid", "profile", "email", "roles"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    }
  ],
  "users": [
    {
      "username": "admin",
      "email": "admin@nuhiris.dev",
